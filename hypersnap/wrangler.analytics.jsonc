{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencaster-analytics",
  "account_id": "e320a5a80611f9a30148d452929b1fb1",
  "main": "analytics/worker.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "analytics.opencaster.org", "custom_domain": true }],
  // Public identifiers for the full-hostname, exact-email Access application.
  // These are not credentials. The Worker verifies its signed assertion again;
  // missing or invalid authentication configuration always denies access.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "blue-night-d7df.cloudflareaccess.com",
    "ACCESS_AUD": "a5168be05b2cf643db477eca2dc11107aef0f8b54b3becaefa6ef6c11e9f7553"
  },
  // Requires Wrangler >=4.145. Account-scoped SQL binding avoids API credentials.
  "analytics": { "binding": "ANALYTICS_SQL" },
  // Access assertions and operator identity must never enter invocation logs.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false },
    "issues": { "enabled": false }
  }
}
