{
  "name": "opencaster",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check:devlog": "node scripts/check-devlog.mjs",
    "analytics:report": "node scripts/analytics-report.mjs",
    "verify": "yarn test && yarn build && yarn signer:build",
    "signer:build": "node scripts/build-signer.mjs",
    "signer:dev": "yarn signer:build && electron dist-signer/main.cjs",
    "signer:package": "node scripts/package-signer.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "1.8.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@tabler/icons-react": "^3.40.0",
    "@walletconnect/core": "2.26.0",
    "@walletconnect/sign-client": "2.26.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.9.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.4",
    "happy-dom": "21.0.3",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "yarn@1.22.22"
}
