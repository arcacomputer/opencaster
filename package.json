{
  "name": "opencaster-repository",
  "private": true,
  "type": "module",
  "description": "Repository entry points for the Opencaster Hypersnap web client.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "22.x",
    "yarn": "1.22.x"
  },
  "scripts": {
    "dev": "yarn --cwd hypersnap dev",
    "build": "yarn --cwd hypersnap build",
    "preview": "yarn --cwd hypersnap preview",
    "test": "yarn --cwd hypersnap test",
    "verify": "yarn --cwd hypersnap verify",
    "check:devlog": "yarn --cwd hypersnap check:devlog",
    "analytics:report": "yarn --cwd hypersnap analytics:report",
    "signer:build": "yarn --cwd hypersnap signer:build",
    "signer:dev": "yarn --cwd hypersnap signer:dev",
    "signer:package": "yarn --cwd hypersnap signer:package"
  },
  "packageManager": "yarn@1.22.22"
}
