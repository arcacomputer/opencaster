{
  "name": "opencaster-repository",
  "private": true,
  "type": "module",
  "description": "Opencaster clients, shared packages, and supporting services.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "22.x",
    "yarn": "1.22.x"
  },
  "scripts": {
    "cloudflare:build": "node scripts/cloudflare-build.mjs build",
    "cloudflare:upload": "node scripts/cloudflare-build.mjs upload",
    "dev": "yarn workspace @opencaster/web-client dev",
    "build": "yarn workspace @opencaster/protocol build && yarn workspace @opencaster/client-core build && yarn workspace @opencaster/web-ui build && yarn workspace @opencaster/web-client build && yarn workspace @opencaster/gateway build && yarn workspace @opencaster/analytics build && yarn signer:build",
    "preview": "yarn workspace @opencaster/web-client preview",
    "test": "vitest run",
    "typecheck": "yarn workspaces run typecheck",
    "verify": "yarn test && yarn build",
    "check:devlog": "node scripts/check-devlog.mjs",
    "analytics:report": "yarn workspace @opencaster/analytics report",
    "signer:build": "yarn workspace @opencaster/signer build",
    "signer:dev": "yarn workspace @opencaster/signer dev",
    "signer:package": "yarn workspace @opencaster/signer package"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "21.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.12",
    "wrangler": "4.159.0"
  },
  "resolutions": {
    "vite": "^7.3.7"
  }
}
