# Preserve private records and caches left by the earlier messenger locally.
# Reports remain private after a fix is merged and until it reaches users.
.agents/issues/.secret/
.agents/**/*.log
.agents/**/*-log.txt
.agents/**/logs/
.agents/**/captures/
.claude/settings.local.json
.claude/skills/changelog-generator/changelogs/*.md
.claude/skills/changelog-generator/changelogs/*.txt
/.quorum-deps/
src/dev/tests/harness/.state/
src/dev/tests/harness/logs/

