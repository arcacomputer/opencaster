{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hypersnap-quorum",
  "account_id": "e320a5a80611f9a30148d452929b1fb1",
  "main": "src/index.ts",
  // Preserve the temporary Haatz primary during the private-node reinstall.
  // Restore the private origin and its credential only through an approved cutback.
  "vars": {
    "HYPERSNAP_AGGREGATE_CACHE": "disabled",
    "HYPERSNAP_READ_FALLBACK": "haatz-v1"
  },
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": { "directory": "../../apps/web-client/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "routes": [{ "pattern": "opencaster.org", "custom_domain": true }, { "pattern": "quorum.arca.computer", "custom_domain": true }],
  // Keep dashboard invocation logs enabled on later deployments. Platform logs
  // store request metadata with query strings removed; aggregate analytics below
  // receives only explicitly allowlisted data. Automatic traces remain off.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 },
    "traces": { "enabled": false },
    "issues": { "enabled": false }
  },
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "opencaster_activity" }],
  "ratelimits": [{ "name": "ANALYTICS_RATE_LIMITER", "namespace_id": "109202601", "simple": { "limit": 60, "period": 60 } }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "hypersnap-quorum-media" }],
  "durable_objects": { "bindings": [{ "name": "MEDIA_QUOTA", "class_name": "MediaUploadQuota" }] },
  "migrations": [{ "tag": "media-quota-v1", "new_sqlite_classes": ["MediaUploadQuota"] }]
}
