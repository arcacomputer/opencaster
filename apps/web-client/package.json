{
  "name": "@opencaster/web-client",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "yarn --cwd ../.. test apps/web-client",
    "typecheck": "tsc --noEmit",
    "verify": "yarn --cwd ../.. verify",
    "check:devlog": "yarn --cwd ../.. check:devlog",
    "analytics:report": "yarn --cwd ../.. analytics:report",
    "signer:build": "yarn --cwd ../.. signer:build",
    "signer:dev": "yarn --cwd ../.. signer:dev",
    "signer:package": "yarn --cwd ../.. signer:package"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "1.8.0",
    "@tabler/icons-react": "^3.40.0",
    "@walletconnect/core": "2.26.0",
    "@walletconnect/sign-client": "2.26.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "@opencaster/client-core": "0.2.1",
    "@opencaster/protocol": "0.2.1",
    "@opencaster/web-ui": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.4",
    "happy-dom": "21.0.3",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "yarn@1.22.22",
  "description": "Opencaster browser client.",
  "license": "AGPL-3.0-only"
}
