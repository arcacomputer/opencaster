{
  "expo": {
    "name": "OpenCaster",
    "slug": "opencaster",
    "scheme": "opencaster",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "org.opencaster.app"
    },
    "android": {
      "allowBackup": false,
      "package": "org.opencaster.app"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ]
    ]
  }
}
